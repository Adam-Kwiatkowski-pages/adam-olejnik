---
import { site } from "@/content"
import Shovel from "@/icons/shovel.svg"
import Cog from "@/icons/cog.svg"
import Wrench from "@/icons/wrench.svg"

const icons = { shovel: Shovel, cog: Cog, wrench: Wrench }
---

<section id="sprzet" class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="mb-12 max-w-2xl">
      <p class="mb-2 text-sm font-bold tracking-widest text-primary uppercase">
        {site.equipment.eyebrow}
      </p>
      <h2
        class="font-heading text-3xl font-bold tracking-tight text-balance text-foreground uppercase md:text-5xl"
      >
        {site.equipment.heading}
      </h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        {site.equipment.body}
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        site.equipment.buckets.map((bucket) => {
          const Icon = icons[bucket.icon]
          return (
            <div class="rounded border border-border bg-card p-6">
              <span class="mb-4 flex h-12 w-12 items-center justify-center rounded bg-primary text-primary-foreground">
                <Icon class="h-6 w-6" />
              </span>
              <h3 class="font-heading text-lg font-bold tracking-wide text-card-foreground uppercase">
                {bucket.title}
              </h3>
              <p class="mt-2 leading-relaxed text-muted-foreground">
                {bucket.description}
              </p>
            </div>
          )
        })
      }
    </div>

    <div class="mt-6 rounded border border-border bg-secondary p-6">
      <h3
        class="font-heading text-lg font-bold tracking-wide text-foreground uppercase"
      >
        {site.equipment.callout.heading}
      </h3>
      <p class="mt-2 leading-relaxed text-muted-foreground">
        {site.equipment.callout.body}
      </p>
    </div>
  </div>
</section>
