---
import { site } from "@/content"
---

<footer class="bg-foreground py-10 text-background">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div
      class="flex flex-col items-start justify-between gap-6 border-b border-background/15 pb-8 md:flex-row md:items-center"
    >
      <div class="flex items-center gap-2">
        <span class="font-heading text-xl font-bold tracking-wide uppercase">
          {site.business.name}
        </span>
      </div>
      <p class="max-w-md text-sm leading-relaxed text-background/60">
        {site.footer.blurb}
      </p>
    </div>
    <p class="mt-6 text-sm text-background/50">
      © {site.business.name}. {site.footer.copyright}
    </p>
  </div>
</footer>
