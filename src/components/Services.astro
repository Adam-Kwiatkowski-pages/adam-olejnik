---
import { Picture } from "astro:assets"
import { site } from "@/content"
import { resolveImage } from "@/lib/images"
---

<section id="uslugi" class="bg-background py-16 md:py-24">
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <div class="mb-12 max-w-2xl">
      <p class="mb-2 text-sm font-bold tracking-widest text-primary uppercase">
        {site.services.eyebrow}
      </p>
      <h2
        class="font-heading text-3xl font-bold tracking-tight text-balance text-foreground uppercase md:text-5xl"
      >
        {site.services.heading}
      </h2>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {
        site.services.items.map((service) => (
          <article class="group overflow-hidden rounded border border-border bg-card transition-shadow hover:shadow-lg">
            <div class="relative h-52 overflow-hidden">
              <Picture
                src={resolveImage(service.image)}
                alt={service.image_alt}
                formats={["avif", "webp"]}
                widths={[420, 840]}
                sizes="(min-width: 768px) 33vw, 100vw"
                loading="lazy"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <h3 class="font-heading text-xl font-bold tracking-wide text-card-foreground uppercase">
                {service.title}
              </h3>
              <p class="mt-3 leading-relaxed text-muted-foreground">
                {service.description}
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
